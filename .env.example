# Database
DATABASE_URL=postgresql+asyncpg://metar_user:metar_password@postgres:5432/metar_db
POSTGRES_USER=metar_user
POSTGRES_PASSWORD=metar_password
POSTGRES_DB=metar_db

# Collection
COLLECTION_INTERVAL_MINUTES=60
COLLECTION_TIMEOUT_SECONDS=30
COLLECTION_RETRY_ATTEMPTS=3
COLLECTION_RETRY_DELAY_SECONDS=5

# Sources
NOAA_AWC_BASE_URL=https://aviationweather.gov/api/data/metar
CHECKWX_API_KEY=
CHECKWX_BASE_URL=https://api.checkwx.com/metar
PRIMARY_SOURCE=noaa_awc

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Frontend
API_BASE_URL=http://localhost:8000
